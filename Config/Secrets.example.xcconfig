// Copy this file to the repo root as `Secrets.xcconfig` (it is git-ignored) and fill in your values.
//   cp Config/Secrets.example.xcconfig Secrets.xcconfig
//
// Never put the Mapbox *secret* (sk.) token here. That lives only in ~/.netrc.
// Never put the Fuel Finder client ID/secret or the Supabase service role key here.

// Mapbox default PUBLIC token (starts pk.)
MAPBOX_ACCESS_TOKEN = pk.YOUR_PUBLIC_TOKEN

// Signing. Your Apple Developer Team ID (10 characters, Xcode > Settings > Accounts)
// and a bundle ID you own. The iCloud container is derived from the bundle ID.
DEVELOPMENT_TEAM = YOURTEAMID
WAYFINDER_BUNDLE_ID = com.yourname.wayfinder

// Supabase (stage 10+). Write the host only: `//` starts a comment in xcconfig files,
// so "https://..." would be cut off. The app adds https:// itself.
SUPABASE_URL = YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = YOUR_PUBLISHABLE_KEY
