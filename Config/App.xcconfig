// Shared build settings for Debug and Release.
// Real values come from the git-ignored Secrets.xcconfig at the repo root.
// The `?` makes the include optional so a fresh clone still opens in Xcode.

MAPBOX_ACCESS_TOKEN = MISSING_MAPBOX_TOKEN
DEVELOPMENT_TEAM =
